# ─── Telegram ────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN            # Get from @BotFather
ALLOWED_USERS=                       # Empty = everyone, or comma-separated IDs: 123456,789012

# ─── Engine: "gemini", "whisper" or "qwen" ───────────────
STT_ENGINE=gemini

# ─── Gemini (when STT_ENGINE=gemini) ─────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY   # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LANGUAGE=English

# ─── Whisper (when STT_ENGINE=whisper) ───────────────────
# WHISPER_MODEL=Systran/faster-whisper-large-v2
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=cpu                   # cpu or cuda
WHISPER_COMPUTE=int8                 # int8, float16, float32
WHISPER_LANGUAGE=auto                # Language code or "auto"
WHISPER_BEAM_SIZE=5
WHISPER_IDLE_TIMEOUT=600             # Unload models after 10 mins (in seconds)

WHISPER_MODEL2=ivrit-ai/faster-whisper-v2-d4
WHISPER_SPECIAL_LANG=he
WHISPER_DEVICE2=cpu                 # cpu or cuda
WHISPER_COMPUTE2=int8                # int8, float16, float32

# ─── Qwen3-ASR (when STT_ENGINE=qwen) ────────────────────
# Needs the image built with WITH_QWEN=1 (heavy: torch + transformers).
# Supported languages (30): Chinese, English, Cantonese, Arabic, German, French, Spanish, Portuguese,
#   Indonesian, Italian, Korean, Russian, Thai, Vietnamese, Japanese, Turkish, Hindi, Malay, Dutch,
#   Swedish, Danish, Finnish, Polish, Czech, Filipino, Persian, Greek, Hungarian, Macedonian, Romanian
# NOT supported: Ukrainian, Hebrew (use STT_ENGINE=whisper for those).
# Full list and model card: https://huggingface.co/Qwen/Qwen3-ASR-1.7B
WITH_QWEN=0                          # 1 = install qwen-asr into the image at build time
QWEN_MODEL=Qwen/Qwen3-ASR-1.7B       # or Qwen/Qwen3-ASR-0.6B
QWEN_DEVICE=cuda:0                   # cuda:0 or cpu
QWEN_DTYPE=bfloat16                  # bfloat16, float16, float32
QWEN_LANGUAGE=auto                   # "auto" or a language name, e.g. Japanese, English, Russian
QWEN_MAX_NEW_TOKENS=512              # per chunk
QWEN_CHUNK_SECONDS=30                # long audio is split into chunks at quiet points
QWEN_BATCH_SIZE=4                    # chunks per inference batch (lower if out of VRAM)
QWEN_IDLE_TIMEOUT=600                # Unload model after 10 mins (in seconds)
